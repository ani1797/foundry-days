# Written by scripts/write-env.* after deploy. Copy to .env for manual setup. No API keys: Entra auth only (az login).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-foundry-day2
AZURE_LOCATION=eastus2

# Foundry project (https://<account>.services.ai.azure.com/api/projects/<project>)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# Azure AI Search (notebook 03)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=northwind-policies
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=northwind-kb
# Name of the RemoteTool project connection to the KB MCP endpoint (created by Bicep)
AZURE_AI_KB_CONNECTION_NAME=northwind-kb-mcp

# Observability (notebook 06). Treat as sensitive-ish: it contains an ingestion key, keep .env out of git.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Hosted agent deploy (notebook 07)
AZURE_CONTAINER_REGISTRY_NAME=
